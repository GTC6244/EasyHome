{
  "bind_addr": "0.0.0.0:10700",
  "config_addr": "127.0.0.1:8730",
  "service_name": "Anamanti Core",
  "instance_id": "anamanti-core",
  "stt_addr": "127.0.0.1:10300",
  "tts_addr": "127.0.0.1:10200",
  "tts_voice": null,
  "tts_voices_dir": null,
  "db_path": "anamanti_memory.sqlite",
  "chatlog_path": "anamanti_chatlog.jsonl",
  "promptlog_path": "anamanti_promptlog.jsonl",
  "helix_path": "anamanti_helix",
  "settings_path": "anamanti_settings.json",
  "audio_dump_dir": null,
  "system_prompt": null,
  "home_location": "Austin, Texas",
  "weather_units": "imperial",
  "turn_timeout_secs": 30,
  "memory_backend": "helix",

  "llm": {
    "backend": "ollama",
    "engine": "rig",
    "anthropic_auth": "apikey",
    "anthropic_token_cmd": null,
    "web_search": true,
    "search_provider": "tavily",
    "ollama": { "url": "http://127.0.0.1:11434", "model": "llama3.2" },
    "anthropic": { "model": "claude-opus-5", "max_tokens": 1024 },
    "openai": { "model": "gpt-4o-mini", "max_tokens": 1024 }
  },

  "graphrag": {
    "openai_base_url": "https://api.openai.com",
    "embed_model": "text-embedding-3-small",
    "embed_dims": 1536,
    "anthropic_base_url": "https://api.anthropic.com",
    "extract_model": "claude-haiku-4-5",
    "ingest_interval_secs": 30,
    "recall_k": 6
  },

  "speaker": {
    "enabled": false,
    "model_path": null,
    "match_threshold": 0.55,
    "new_threshold": 0.40,
    "min_speech_ms": 1200,
    "embed_dims": 192
  },

  "stt": {
    "engine": "wyoming",
    "model": "base",
    "model_dir": "models",
    "model_path": null,
    "language": "en",
    "num_threads": 0
  },

  "follow_up": {
    "enabled": true,
    "max_chain": 0,
    "question_wait_secs": 10,
    "reply_wait_secs": 5,
    "history_turns": 5,
    "history_window_secs": 600
  },

  "music": {
    "enabled": true,
    "snapserver_addr": "127.0.0.1:1705",
    "duck_on_speech": true,
    "duck_percent": 30,
    "group": null,
    "stream": null,
    "web_ipc": "/tmp/ambient-mpv.sock",
    "bin_dir": "/opt/homebrew/bin",
    "run_dir": "/opt/homebrew/var/run/ambient",
    "log_dir": "/opt/homebrew/var/log",
    "conf": "/opt/homebrew/etc/snapserver.conf",
    "spotify_device_name": "Ambient",
    "autostart": true
  },

  "calendar": {
    "subscriptions": [],
    "cache_ttl_secs": 300
  },

  "directions": {
    "provider": "mapbox"
  },

  "weather": {
    "enabled": true,
    "refresh_interval_secs": 1800
  },

  "system1": {
    "backend": "none",
    "base_url": "http://127.0.0.1:8000",
    "openrouter_model": "typesafe/jev-1.13",
    "device": "metal",
    "model": "convaiinnovations/laya",
    "min_confidence": 0.85,
    "intents": []
  },

  "drive": {
    "client_id": null,
    "client_secret": null,
    "folder_ids": [],
    "scope": "https://www.googleapis.com/auth/drive.readonly"
  },

  "spotify": {
    "client_id": null,
    "client_secret": null,
    "refresh_token": null,
    "device_name": "Ambient"
  },

  "cadora": {
    "base_url": "https://cadora-server.fly.dev",
    "link_token": null
  }
}
